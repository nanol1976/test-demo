# Batch34：云主机（ops-vm）执行岗的配置模板。
# 复制到 ~/.mwp/worker.env 后 chmod 600；这份是模板，不要提交任何真实口令。
#
# 注意：MWP_BASE_URL 现在填不通——云主机到 Windows 平台没有直连路由。
# 先把这条通道解决掉（Tailscale 组网 / Windows 上开隧道），再启 ops-vm.sh。

# 平台地址（走通通道后填隧道/组网地址，不要写 127.0.0.1）
MWP_BASE_URL=http://<通道地址>:8000

# 仓库绝对路径
MWP_REPO=/home/user/Doubao/chats/38453626885714946/mwp-b33

# 执行方口令（不是全权口令，也不能派单）
MWP_TOKEN_WORKER=

# 执行方身份与岗位
MWP_WORKER_ID=workbuddy
MWP_INSTANCE=ops-vm
MWP_CONCURRENCY=1

# dsh 的运行 home（默认仓库下 run/dsh_home，绝不碰 ~/.dsh）
# MWP_DSH_HOME=
# 凭证：云主机上没有 ~/.dsh/.credentials.yaml 时，用这个指到仓库内的文件（gitignore 里）
# MWP_DSH_CREDENTIALS=/home/user/Doubao/chats/38453626885714946/mwp-b33/run/dsh_cred.yaml
