# ===== 存储 =====
DATABASE_URL=sqlite:///./data/mw_platform.db
ARCHIVE_ROOT=./archive

# ===== 日志 =====
LOG_LEVEL=INFO

# ===== 鉴权 =====
# 留空 = 完全不校验（仅限本地开发）
# 生产必须设，客户端请求需带 X-API-Token 头
API_TOKEN=

# ===== 总线 =====
BUS_CAPACITY=1000
BUS_WORKERS=2

# ===== 分页 =====
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100

# ===== 调度判定（Batch4）=====
# 派发后多久未回传判失败（秒）
TASK_TIMEOUT_SECONDS=3600
# 多久无心跳只告警（秒，不杀任务）
HEARTBEAT_TIMEOUT_SECONDS=120
# 同 trace 失败任务数达多少触发熔断
FAILURE_THRESHOLD=3
# 后台判定线程扫描间隔（秒）
SCAN_INTERVAL_SECONDS=5.0
