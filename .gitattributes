# 统一换行符：仓库内一律 LF（写成 CRLF 会把 run.sh / *.sh 在 Linux 上跑坏）
* text=auto eol=lf

# PowerShell / 批处理必须是 CRLF（Windows 原生解析器认这个）
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制，不做换行归一
*.png binary
*.jpg binary
*.ico binary
*.gz binary
*.tar.gz binary
*.db binary

# 前端与文档明确用 LF
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.txt text eol=lf
